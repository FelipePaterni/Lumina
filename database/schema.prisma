datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model HealthPersistence {
  id        String   @id @default(uuid())
  status    String   @default("ok")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("health_persistence")
}

enum Role {
  ADMIN
  CATALOG
  STOCK
  CUSTOMER
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String    @map("password_hash")
  role                Role      @default(CUSTOMER)
  isEmailConfirmed    Boolean   @default(false) @map("is_email_confirmed")
  isActive            Boolean   @default(true) @map("is_active")
  deactivatedAt       DateTime? @map("deactivated_at") @db.Timestamptz(6)
  scheduledDeletionAt DateTime? @map("scheduled_deletion_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]

  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model OutboxEmail {
  id        String    @id @default(uuid())
  toEmail   String    @map("to_email")
  subject   String
  body      String
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("outbox_emails")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actorRole  Role?    @map("actor_role")
  action     String   @db.VarChar(100)
  targetType String   @map("target_type") @db.VarChar(50)
  targetId   String?  @map("target_id")
  reason     String?  @db.Text
  metadata   String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model Author {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  works     Work[]

  @@map("authors")
}

model Publisher {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  works     Work[]

  @@map("publishers")
}

model Category {
  id    String         @id @default(uuid())
  name  String         @unique
  works WorkCategory[]

  @@map("categories")
}

model Work {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  synopsis    String         @db.Text
  coverUrl    String?        @map("cover_url")
  isbn        String?
  language    String         @default("pt-BR")
  releaseDate DateTime       @map("release_date") @db.Date
  edition     String?
  isVisible   Boolean        @default(true) @map("is_visible")
  authorId    String         @map("author_id")
  publisherId String         @map("publisher_id")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  author      Author         @relation(fields: [authorId], references: [id])
  publisher   Publisher      @relation(fields: [publisherId], references: [id])
  categories  WorkCategory[]
  editions    Edition[]

  @@index([title])
  @@index([authorId])
  @@map("works")
}

model WorkCategory {
  workId     String   @map("work_id")
  categoryId String   @map("category_id")
  work       Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([workId, categoryId])
  @@map("work_categories")
}

enum EditionFormat {
  PHYSICAL
  DIGITAL
}

model Edition {
  id           String        @id @default(uuid())
  workId       String        @map("work_id")
  format       EditionFormat
  isbn         String?
  priceCents   Int           @map("price_cents")
  isVisible    Boolean       @default(true) @map("is_visible")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  work         Work          @relation(fields: [workId], references: [id], onDelete: Cascade)
  inventory    Inventory?
  digitalAsset DigitalAsset?

  @@unique([workId, format])
  @@index([priceCents])
  @@map("editions")
}

model Inventory {
  id                  String              @id @default(uuid())
  editionId           String              @unique @map("edition_id")
  physicalStock       Int                 @default(0) @map("physical_stock")
  digitalLicenseLimit Int?                @map("digital_license_limit")
  digitalAllocated    Int                 @default(0) @map("digital_allocated")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  edition             Edition             @relation(fields: [editionId], references: [id], onDelete: Cascade)
  movements           InventoryMovement[]

  @@map("inventories")
}

enum InventoryMovementType {
  PHYSICAL_ADJUSTMENT
  DIGITAL_ALLOCATION
  DIGITAL_RELEASE
}

model InventoryMovement {
  id          String                @id @default(uuid())
  inventoryId String                @map("inventory_id")
  type        InventoryMovementType
  quantity    Int
  reason      String                @db.Text
  actorId     String?               @map("actor_id")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  inventory   Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId, createdAt])
  @@map("inventory_movements")
}

model DigitalAsset {
  id        String                @id @default(uuid())
  editionId String                @unique @map("edition_id")
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  edition   Edition               @relation(fields: [editionId], references: [id], onDelete: Cascade)
  versions  DigitalAssetVersion[]

  @@map("digital_assets")
}

model DigitalAssetVersion {
  id          String       @id @default(uuid())
  assetId     String       @map("asset_id")
  version     Int
  storageKey  String       @map("storage_key") @db.VarChar(500)
  checksum    String       @db.VarChar(128)
  mimeType    String       @map("mime_type") @db.VarChar(120)
  isOriginal  Boolean      @default(false) @map("is_original")
  createdById String?      @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  asset       DigitalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, version])
  @@index([assetId, isOriginal])
  @@map("digital_asset_versions")
}
